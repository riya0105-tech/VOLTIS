# Database configuration (PostgreSQL local development example)
DATABASE_URL=postgresql+psycopg2://voltis:voltis_dev@localhost:5432/voltis

# MQTT Broker configuration
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=voltis/factory/+/machine/+/telemetry
MQTT_ENABLED=false

# AI Copilot / LLM configuration
LLM_API_KEY=

# CORS Origins (comma-separated URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Factory & Environmental Configurations
EMISSION_FACTOR=0.82

# Application Settings
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
